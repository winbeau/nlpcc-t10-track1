# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# ---- uv / venv ----
.venv/
uv.lock          # keep out until env is pinned on the server; remove this line to commit a lockfile

# ---- task data & derived artifacts (DO NOT COMMIT official data; usage policy) ----
data/*
!data/.gitkeep
images/
*.zip
*.jsonl          # derived splits / preds; official data lives in ../NLPCC-2026-Task10-Science
# ...but DO track the final Codabench submissions (predictions only = {id, labels}; safe per policy).
# Naming: testp1_s{NN}_{tag}.{zip,jsonl} (see CLAUDE.md §8). No more `git add -f` needed.
!submissions/
!submissions/testp1_s*.zip
!submissions/testp1_s*.jsonl

# ---- model / training outputs ----
outputs/*
!outputs/.gitkeep
checkpoints/
*.safetensors
*.bin
*.pt
wandb/
runs/

# ---- misc ----
.DS_Store
.ipynb_checkpoints/
*.log
